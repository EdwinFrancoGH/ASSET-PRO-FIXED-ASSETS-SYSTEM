# Copia este archivo a ".env" (desarrollo) o pon estas variables en Render → Environment.
PORT=5001

# URL(s) del frontend, separadas por coma. Se usan para CORS y para los enlaces de los correos.
FRONTEND_URL=http://localhost:3001
# true = acepta también las vistas previas https://*.vercel.app
CORS_VERCEL_PREVIEWS=false

# Credenciales de Firebase Admin. En local basta con backend/credentials/firebase-key.json.
# En Render pega aquí el JSON completo de la cuenta de servicio (o en base64).
FIREBASE_SERVICE_ACCOUNT=

ZONA_HORARIA=America/El_Salvador

# Google Maps (opcional): Routes API + Geocoding API
GOOGLE_MAPS_API_KEY=

# Correo de notificaciones (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ASSET PRO CONSOLE (opcional)
CONSOLE_URL=
CONSOLE_SENSOR_KEY=
