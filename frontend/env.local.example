# Copia a ".env.local" (desarrollo) o ponlas en Vercel → Settings → Environment Variables.
# En Vercel: NEXT_PUBLIC_API_URL = https://<tu-servicio>.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=asset-pro-fixed-assets.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=asset-pro-fixed-assets
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Embed API (opcional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
